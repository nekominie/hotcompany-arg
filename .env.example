# =============================================================================
# FISINOR - Variables de entorno para despliegue de pruebas en producción
# =============================================================================
# 1. Copia este archivo como `.env` y rellena los valores reales.
# 2. Nunca subas `.env` a Git.
# 3. Las URLs deben coincidir con los dominios o puertos que expongas.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=cambia_esta_contraseña_segura

# -----------------------------------------------------------------------------
# ASP.NET Core
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# Orígenes permitidos por CORS. Lista separada por comas.
# Ejemplo para dominios reales:
# CORS_ALLOWED_ORIGINS=https://fisinor.com,https://admin.fisinor.com,https://clientes.fisinor.com,https://empleados.fisinor.com
# Ejemplo para prueba por IP/puertos:
# CORS_ALLOWED_ORIGINS=http://203.0.113.10:8080,http://203.0.113.10:8081,http://203.0.113.10:8082,http://203.0.113.10:8083
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Resend (correos transaccionales)
# -----------------------------------------------------------------------------
# Sin API key los correos NO se envían; solo se registran en los logs de la API.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# URLs públicas de los portales
# -----------------------------------------------------------------------------
# Debe apuntar al frontend donde el usuario restablece su contraseña.
# Si usas subdominios:
RECOVERY_RESET_BASE_URL=https://clientes.fisinor.com/reset-password
# Si usas puertos directos:
# RECOVERY_RESET_BASE_URL=http://203.0.113.10:8082/reset-password
