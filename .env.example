# PostgreSQL
POSTGRES_PASSWORD=cambia_esta_contraseña_segura

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production

# Orígenes permitidos por CORS (URLs reales de los frontends, separadas por coma)
CORS_ALLOWED_ORIGINS=https://fisinor.com,https://admin.fisinor.com,https://clientes.fisinor.com,https://empleados.fisinor.com

# Resend (opcional; sin API key los correos solo se loguean)
RESEND_API_KEY=re_xxxxxxxx

# URL pública para el enlace de restablecimiento de contraseña del portal de clientes
RECOVERY_RESET_BASE_URL=https://clientes.fisinor.com/reset-password
